# Copy to .env and fill in whichever you have. Every key is optional —
# anything you leave blank falls back to a free, no-account provider.
# Run `python -m admaker providers` for costs and signup links.

# --- Script (the highest-leverage upgrade) ---
GROQ_API_KEY=            # FREE tier, no card    https://console.groq.com/keys
GEMINI_API_KEY=          # FREE tier, no card    https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # has free models       https://openrouter.ai/keys
ANTHROPIC_API_KEY=       # paid, best ad copy    https://console.anthropic.com/settings/keys
OPENAI_API_KEY=          # paid                  https://platform.openai.com/api-keys

# --- Images / video ---
FAL_KEY=                 # paid, cheapest good   https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=     # paid                  https://replicate.com/account/api-tokens

# --- Voiceover (the default, Edge TTS, needs no key) ---
ELEVENLABS_API_KEY=      # free 10k chars/month  https://elevenlabs.io/app/settings/api-keys
GOOGLE_TTS_API_KEY=      # free 1M chars/month   https://console.cloud.google.com/apis/credentials

# Use a system ffmpeg instead of the bundled one
# ADMAKER_FFMPEG=/usr/bin/ffmpeg
